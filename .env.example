# ============================================================
# HIKARU 環境変数テンプレート
# このファイルをコピーして .env.local を作成してください
# .env.local は絶対にGitにコミットしないこと
# ============================================================

# ============================================================
# OpenAI（サーバーサイドのみ使用）
# https://platform.openai.com/api-keys
# ============================================================
OPENAI_API_KEY=

# ============================================================
# Supabase（公開可 - クライアントサイドで使用）
# Supabase Dashboard > Settings > API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
# Supabase（サーバーサイドのみ使用 - 絶対に公開しない）
# Supabase Dashboard > Settings > API > service_role
# ============================================================
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# アプリ設定
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# アプリ間ルーティング（ロール別リダイレクト）
# ============================================================
# HIKARU-System（作業者・オーナー向け）
NEXT_PUBLIC_SYSTEM_URL=http://localhost:3000
# HIKARU-CONSOLE（管理者向け）
NEXT_PUBLIC_CONSOLE_URL=http://localhost:3001

# ============================================================
# Phase 4: LINE通知（サーバーサイドのみ。絶対に NEXT_PUBLIC_ にしない）
# LINE Developers > チャンネル > Messaging API
# ============================================================
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ============================================================
# Phase 4: 各システムのベースURL（LINE通知のリンク生成用）
# 本番環境では実際のURLを設定する
# ============================================================
HIKARU_CONSOLE_URL=http://localhost:3001
HIKARU_SYSTEM_URL=http://localhost:3000
HIKARU_PARTNER_URL=http://localhost:3002
HIKARU_CLIENT_URL=http://localhost:3003

# ============================================================
# Phase 4: 期限超過請求書通知 Cron 認証シークレット（任意）
# Vercel Cron Jobs から /api/invoices/overdue を叩く際に使用
# ============================================================
CRON_SECRET=

# ============================================================
# Phase 2G: メール送信（サーバーサイドのみ。絶対に NEXT_PUBLIC_ にしない）
# Resend Dashboard > API Keys で発行
# https://resend.com
# ============================================================
RESEND_API_KEY=

# 送信元アドレス（Resendでドメイン認証済みのアドレスを使用）
# 形式: "表示名 <メールアドレス>"
# 例: HIKARU <info@asiavision.link>
# ※ ドメイン認証前はResend提供の onboarding@resend.dev で代替可（開発環境のみ）
EMAIL_FROM=
